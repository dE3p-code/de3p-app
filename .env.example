# Kopieer dit bestand naar  .env  en vul de waarden in.

# --- Strava (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Wordt automatisch ingevuld door get_strava_token.py:
STRAVA_REFRESH_TOKEN=

# --- Notion ---
# Interne integratie-token (https://www.notion.so/my-integrations) -> "Internal Integration Secret".
# Deel daarna de pagina "Marathon Antwerpen — Trainingsschema" met die integratie
# (... -> Connections -> jouw integratie).
NOTION_TOKEN=
# Page-id van het marathonschema (staat al ingevuld):
NOTION_PAGE_ID=jouw-notion-pagina-id

# --- Ollama (lokaal) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:latest
USE_OLLAMA=true

# --- Gedrag ---
LOG_TO_NOTION=true
POLL_LOOKBACK_DAYS=3
